                "@Type": "f3878285",
                "@Value": {
                  "TextBlobForSerialisation": "(string)FUNCTION UDS_ReadCallback\nVAR_INPUT\n    //a variable to which the content has to be written\n    UDSReadData_pau8 : POINTER TO USINT;\nEND_VAR\nVAR\n    // variables for internal operations\n    //data_au8 : ARRAY[0..8] OF BYTE;\n    i                     : BYTE;\n    DidValue_u16          : UINT;\n    set_u8                : USINT;\n    ret_secLevel          : UINT;\n    Level_pu16            : POINTER TO UINT;\n    ret_response          : BOOL;\n    temp_sec_level        : BOOL;\n    uPmpSnsr_mV_u16       : UINT;\n    fctPmp_s16            : INT;\n    stBrkSwt_u8           : USINT;\n    iPmpFwdAct_mA_u16     : UINT;\n    funcRet_u8            : USINT;\n    UDSReadData_pau8_poby : POINTER TO ARRAY[0..7] OF BYTE;\n    UDSReadData_pau8_by   : ARRAY[0..7] OF BYTE;\n    DID_0103_s32          : DINT;\n    DiagChkLvlRet_u8      : USINT;\nEND_VAR\n",
                  "LineInfoPersistence": "(string)5ab2f861-41ac-4de8-a14f-18c98d17a19c_Decl_LineIds"
