            "@Type": "3b83b776",
            "@Value": {
              "TextDocument": {
                "@Type": "f3878285",
                "@Value": {
                  "TextBlobForSerialisation": "(string)IF( NOT( st_InitDone_b ) ) THEN \n\t(******************************************************************************)\n\t(******************** Initialization: CAN communication  **********************)\n\t(******************************************************************************)\n\tINIT_initCAN();\n\t\n\t\n\t(******************************************************************************)\n\t(******************** Configuration: Input  ***********************************)\n\t(******************************************************************************)\n\tINIT_cfgInputs();\n\t\n\t\n\t(******************************************************************************)\n\t(******************** Configuration: Outputs **********************************)\n\t(******************************************************************************)\n\tINIT_cfgOutputs();\n\t\n\t\n\t(******************************************************************************)\n\t(******************** Initalization: UDS **************************************)\n\t(******************************************************************************)\n\tINIT_initUDS();\n\t\n\t\n\t(******************************************************************************)\n\t(******************** Initalization: NVM **************************************)\n\t(******************************************************************************)\n\tINIT_initNVM();\n\t\n\t\n\t(******************************************************************************)\n\t(******************** Initalization: General System****************************)\n\t(******************************************************************************)\n\tINIT_initSys();\n\t\n\t(******************** Initalization: Errors ***********************************)\n\tPRG_DebugManager.ACT_InitDebugManager();\n\t\n\t(* Set Init Done *)\n\tst_InitDone_b := TRUE;\n\t\nEND_IF",
                  "LineInfoPersistence": "(string)14a446be-14de-4c89-a1ac-02c0c2636bcd_Impl_LineIds"
                }
              }
            }
          },
          "Interface": {
            "@Type": "a9ed5b7e",
            "@Value": {
              "TextDocument": {
                "@Type": "f3878285",
                "@Value": {
                  "TextBlobForSerialisation": "(string)(*********************************************************************************************************************\n *     __   __   ___  ___           __   __        __   __  ___\n *   /_ / /  / /__  /    /__/     /_ / /_   |_ / /_ / /  /  /  /__/\n *  /__/ /__/ __ / /__  /  /     /  | /__  /  | /  | /__/  /  /  /\n *\n * Project: Hello World for ml290.rts\n *\n * Program: PLC_PRG\n *\n * Description:\n * PLC_PRG for initialization\n *\n * (c) Copyright by BOSCH REXROTH AG, all rights reserved\n *\n *********************************************************************************************************************)\nPROGRAM INIT_PRG\n\nVAR\n\tst_InitDone_b      : BOOL;\n\tResetInfo_struc    : bds_ResetInfo_ts;\n \tResetInfoData_au32 : ARRAY[0..1] OF UDINT;\n\t\n\tApplSwName_str     : STRING(50) := 'Hello World ml290.rts';\n\n\tUDSUUID_no_au8     : ARRAY[1..18] OF USINT;\n\t\n\tstatus_u16 : UINT;\nEND_VAR",
                  "LineInfoPersistence": "(string)14a446be-14de-4c89-a1ac-02c0c2636bcd_Decl_LineIds"
