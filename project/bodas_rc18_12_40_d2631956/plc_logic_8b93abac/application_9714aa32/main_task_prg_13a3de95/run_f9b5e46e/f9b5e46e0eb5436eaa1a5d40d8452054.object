              "TextDocument": {
                "@Type": "f3878285",
                "@Value": {
                  "TextBlobForSerialisation": "(string)(******************************************************************************)\n(**************************** CAN Wakeup Handling   ***************************)\n(******************************************************************************)\n(* resetInfo_s.rbr_UserDefined_u32 = 0x01 means that the Wakeup has happened via CAN via CAN Channel 1 *)\n(* resetInfo_s.rbr_UserDefined_u32 = 0x04 means that the Wakeup has happened via CAN via CAN Channel 4 *)\nIF ((16#01 = INIT_PRG.ResetInfo_struc.rbr_UserDefined_u32) OR (16#04 = INIT_PRG.ResetInfo_struc.rbr_UserDefined_u32)) THEN\n    bds_sys_cancelAltWakeup(); (* forces system state to go to POSTRUN *)\nEND_IF\n",
                  "LineInfoPersistence": "(string)f9b5e46e-0eb5-436e-aa1a-5d40d8452054_Impl_LineIds"
                }
              }
            }
          },
          "UniqueIdGenerator": "(string)35"
        }
