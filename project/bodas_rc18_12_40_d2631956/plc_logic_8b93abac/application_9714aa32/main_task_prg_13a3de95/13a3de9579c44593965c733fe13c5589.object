    "object": {
      "Graph": {
        "@Type": "6f9dac99",
        "@Value": {
          "SpecialFunc": {
            "@Type": "0db3d7bb:Enum",
            "@Value": "None"
          },
          "Implementation": {
            "@Type": "3b83b776",
            "@Value": {
              "TextDocument": {
                "@Type": "f3878285",
                "@Value": {
                  "TextBlobForSerialisation": "(string)CASE MainTaskState_enu OF\n\n\tenu_MainTaskState.MT_INIT:\n\t\t(* Initialization state - only once *)\n\t\tINIT();\n\t\n\t\tStartRelease_st_b := FALSE;\n\t\tMainTaskState_enu := enu_MainTaskState.MT_CYCLE;\n\n\tELSE (* -> MT_CYCLE and default state *)\n\t\t(* Cyclic state *)\n\t\n\t\t(* Read inputs *)\n\t\tINPUTS();\n\t\n\t\tIF( StartRelease_st_b ) THEN\n\t\t\tIF( PostRun_st_b ) THEN\n\t\t\t\t(* Postrun *)\n\t\t\t\tPOSTRUN();\n\t\t\tELSE\t\n\t\t\t\t(* Normal operational mode *)\n\t\t\t\t//_RUN();\n\t\t\tEND_IF\n\n\t\tELSE\n\t\t\t(* Wait for start release *)\n\t\t\tSTARTLOCK();\n\t\tEND_IF\n\t\n\t\t(* Set CAN outputs *)\n\t\tCAN_OUT();\n\t\n\t\t(* Error management *)\n\t\tERRORS();\n\t\n\t\t(* Set outputs *)\n\t\tOUTPUTS();\n\t\n\t\t(* Reads the parameter from EEPROM *)\n\t\tREAD_PARAMETERS();\n\nEND_CASE\n",
                  "LineInfoPersistence": "(string)13a3de95-79c4-4593-965c-733fe13c5589_Impl_LineIds"
                }
              }
            }
          },
          "Interface": {
            "@Type": "a9ed5b7e",
            "@Value": {
              "TextDocument": {
                "@Type": "f3878285",
                "@Value": {
                  "TextBlobForSerialisation": "(string)(*********************************************************************************************************************\n *    __   __   ___  ___           __   __        __   __  ___\n *   /_ / /  / /__  /    /__/     /_ / /_   |_ / /_ / /  /  /  /__/\n *  /__/ /__/ __ / /__  /  /     /  | /__  /  | /  | /__/  /  /  /\n *\n * Project: Hello World for ml290.rts\n *\n * Program: Main_Task_PRG\n *\n * Description:\n * Main loop of application\n *\n * (c) Copyright by BOSCH REXROTH AG, all rights reserved\n *\n *********************************************************************************************************************)\nPROGRAM MAIN_TASK_PRG\n\nVAR\n(******************************************************************************)\n(*************************** _Init ********************************************)\n(******************************************************************************)\n\n\n(******************************************************************************)\n(*************************** _Starlock ****************************************)\n(******************************************************************************)\nStartRelease_st_b  : BOOL;   (*State of the startlock: 1 = the program runs*)\n\n(******************************************************************************)\n(*************************** _Run *********************************************)\n(******************************************************************************)\n\n\n(******************************************************************************)\n(*************************** _PostRun *****************************************)\n(******************************************************************************)\nPostRun_st_b         : BOOL;   (*State of the postrun: 1 = the post runs*)\nCallPostRunNr_no_u16 : UINT;\nStates_s             : bds_sys_states_ts;\n(******************************************************************************)\n(*************************** _Errors ******************************************)\n(******************************************************************************)\n\n\n(******************************************************************************)\n(*************************** _CAN *********************************************)\n(******************************************************************************)\n\n\n(******************************************************************************)\n(*************************** General ******************************************)\n(******************************************************************************)\nst_Startlock_b    : BOOL;\nMainTaskState_enu : enu_MainTaskState := enu_MainTaskState.MT_INIT;\t\t\t(* variable indicating the mode of the main task callback function (MT_INIT, MT_CYCLE) *)\nEND_VAR\n\nVAR CONSTANT\n\tDELAY_STANDARD       : INT  := 2000; (* debouncing time 2000[ms]*)\n\tTaskCycleTime_ms_u16 : UINT := 10;   (* Task Cycle Time *) \nEND_VAR\n",
                  "LineInfoPersistence": "(string)13a3de95-79c4-4593-965c-733fe13c5589_Decl_LineIds"
                }
              }
            }
          },
          "UniqueIdGenerator": "(string)393",
          "POULevel": {
            "@Type": "8e575c5b:Enum",
            "@Value": "Standard"
          },
          "ChildObjectGuids": {
            "@Type": "ArrayList:IList",
            "@Value": []
          },
          "AddAttributeSubsequent": "(bool)False"
        }
      },
