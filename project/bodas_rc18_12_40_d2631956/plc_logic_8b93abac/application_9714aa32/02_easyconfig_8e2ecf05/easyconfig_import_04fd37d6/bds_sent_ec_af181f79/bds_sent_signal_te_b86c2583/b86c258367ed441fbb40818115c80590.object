                "@Type": "f3878285",
                "@Value": {
                  "TextBlobForSerialisation": "(string)///Definition configuration of available SENT signals (consists signals of all variants)\n{attribute 'qualified_only' := ''}\n{attribute 'strict' := ''}\nTYPE bds_sent_signal_te : (\n        ///X_X_X03\n        bds_sent_K53_E := 0,\n        ///X_X_X04\n        bds_sent_K59_E,\n        ///X_X_X16\n        bds_sent_K57_E,\n        ///X_X_X17\n        bds_sent_K58_E,\n        ///X_X_X18\n        bds_sent_K36_E,\n        ///X_X_X19\n        bds_sent_K56_E,\n        bds_sent_numSignal_E\n    ) USINT;\nEND_TYPE\n",
